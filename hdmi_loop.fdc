# Board oscillator and 1080p60 HDMI receiver pixel clock assumptions.
create_clock -name {sys_clk} [get_ports {sys_clk}] -period {37.037} -waveform {0.000 18.5185}
create_clock -name {pix_clk} [get_ports {pixclk_in}] -period {6.734} -waveform {0.000 3.367}
create_generated_clock -name {cfg_clk} -source [get_ports {sys_clk}] [get_nets {cfg_clk}] -master_clock [get_clocks {sys_clk}] -multiply_by {10} -divide_by {27}
set_clock_groups -asynchronous -group [get_clocks {sys_clk cfg_clk}] -group [get_clocks {pix_clk}]

